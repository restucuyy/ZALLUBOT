# ===== ZALLUBOT - salin file ini menjadi .env lalu isi dengan data KAMU SENDIRI =====
MAX_BOT = 100
# ID Telegram kamu (pisahkan spasi kalau lebih dari satu)
DEVS =
OWNER_ID =
# Ambil API_ID & API_HASH dari https://my.telegram.org
API_ID =
API_HASH =
# Token bot pembuat userbot dari @BotFather
BOT_TOKEN =
# ID chat yang diblacklist (opsional, pisahkan spasi)
BLACKLIST_CHAT =
# API key removebg (opsional) - daftar di remove.bg
RMBG_API =
# Database TIDAK pakai MongoDB lagi. Data disimpan lokal otomatis di
# data/zallubot.db - tidak perlu diisi apa-apa.
# ID grup/channel log pembuat ubot (angka, contoh -1001234567890)
LOGS_MAKER_UBOT =
# Untuk modul qris (opsional, dari KiPay.id - console.kipay.id)
# Pakai API key project PRODUCTION untuk transaksi asli
KIPAY_API_KEY =
KIPAY_MODE = production
# Rich Message (tabel HTML + tombol berwarna, Bot API) untuk layar bot
# pembuat userbot: on (default) / off. Pesan userbot tidak terpengaruh.
RICH_MESSAGES = on
# Untuk modul subdocreate (opsional, dari Cloudflare)
CLOUDFLARE_API_TOKEN =
